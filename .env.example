DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# Set to false only when PostgreSQL is reached over a trusted private network without TLS.
DATABASE_SSL="true"

# Google Workspace OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.com/auth/google/callback"

# Optional but recommended: restrict sign-in to your Google Workspace domain.
GOOGLE_WORKSPACE_DOMAIN="your-company.com"

# Comma-separated Google Workspace emails that can add software and manage staff visibility.
ADMIN_EMAILS="admin@your-company.com,it.manager@your-company.com"

# Used to sign the portal session cookie. Generate a long random value.
AUTH_SECRET="replace-with-a-long-random-secret"

# Shared with connected apps so they can verify portal SSO tokens.
PORTAL_SSO_SECRET="replace-with-another-long-random-secret"
